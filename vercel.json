{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "devtoolio.tech"
        }
      ],
      "destination": "https://www.devtoolio.tech/",
      "statusCode": 301
    },
    {
      "source": "/:path+/",
      "has": [
        {
          "type": "host",
          "value": "devtoolio.tech"
        }
      ],
      "destination": "https://www.devtoolio.tech/:path+",
      "statusCode": 301
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "devtoolio.tech"
        }
      ],
      "destination": "https://www.devtoolio.tech/:path+",
      "statusCode": 301
    }
  ]
}
